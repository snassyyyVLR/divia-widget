<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base (API 21-22): red status bar (white icons are only readable
         over it there); values-v23 switches to a light bar with dark
         icons, the modern look. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#E2001A</item>
        <item name="android:colorPrimaryDark">#E2001A</item>
        <item name="android:colorAccent">#E2001A</item>
        <item name="android:statusBarColor">#E2001A</item>
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>
</resources>
