<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: soft 18dp corners + a hairline stroke so the white card
     also reads on light wallpapers (night: dark card on dark walls). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_bg"/>
    <corners android:radius="18dp"/>
    <stroke android:width="1dp" android:color="@color/widget_stroke"/>
</shape>
