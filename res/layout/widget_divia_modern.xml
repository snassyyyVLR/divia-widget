<?xml version="1.0" encoding="utf-8"?>
<!--
  Divia widget, v1.6.0 MODERN layout variant: every departure is a soft
  rounded card with the line's pill badge, the destination, big minutes and
  a small clock. Pushed instead of widget_divia.xml when the widget's
  config has layout=2 (WidgetPrefs.LAYOUT_MODERN).

  HARD CONSTRAINT — @RemoteView whitelist: identical to widget_divia.xml,
  the launcher inflates this file in ITS OWN process through
  RemoteViews.apply(); only @RemoteView-annotated classes are allowed
  (LinearLayout, ImageView, TextView here). check_widget_layout.py and the
  JVM LayoutWhitelist guard both re-assert this.

  ID REUSE — every id that exists in widget_divia.xml keeps the SAME name
  (and therefore the same pinned numeric id from stable-ids.txt): row0..4,
  dest0..4, count0..4, clock0..4, stop_name, line_dest, line_badge,
  empty_status, updated, widget_root — plus the compact layout's per-row
  badges cbadge0..4 (already pinned since 1.5.0). No new ids at all, so a
  launcher re-applying RemoteViews cached under ANY previous version or
  disposition keeps resolving.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- Header: line badge + stop name + direction. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/line_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp">

            <TextView
                android:id="@+id/stop_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/txt_main"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Divia"/>

            <TextView
                android:id="@+id/line_dest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/txt_sub"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="…"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Departure rows: each a soft 32dp card with 6dp gaps. -->
    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="@drawable/row_card_bg">

        <ImageView
            android:id="@+id/cbadge0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/dest0"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/txt_main"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/countdown"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/clock0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/txt_clock"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="@drawable/row_card_bg">

        <ImageView
            android:id="@+id/cbadge1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/dest1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/txt_main"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/countdown"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/clock1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/txt_clock"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="@drawable/row_card_bg">

        <ImageView
            android:id="@+id/cbadge2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/dest2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/txt_main"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/countdown"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/clock2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/txt_clock"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="@drawable/row_card_bg">

        <ImageView
            android:id="@+id/cbadge3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/dest3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/txt_main"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/countdown"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/clock3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/txt_clock"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="@drawable/row_card_bg">

        <ImageView
            android:id="@+id/cbadge4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/dest4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/txt_main"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/countdown"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/clock4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/txt_clock"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Empty / error status -->
    <TextView
        android:id="@+id/empty_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/txt_sub"
        android:textSize="11sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"/>

    <!-- Footer -->
    <TextView
        android:id="@+id/updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/txt_clock"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="6dp"/>
</LinearLayout>
