<?xml version="1.0" encoding="utf-8"?>
<!-- App home: the clean widget manager. Diagnostics live in Settings.
     v1.6.0 polish: tinted banners, hero empty state, footer status card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/home_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/txt_main"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/home_title"/>

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:background="@drawable/btn_icon"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_gear"/>
    </LinearLayout>

    <!-- v1.2.0: update banner — visible only when a newer GitHub release is
         cached; tapping opens the install flow. -->
    <TextView
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/banner_update_bg"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:textColor="@color/countdown"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"/>

    <!-- v1.5.0: catalog expiry banner — appears 30 days before the bundled
         timetable stops covering the network; tapping runs an update check. -->
    <TextView
        android:id="@+id/catalog_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/banner_warn_bg"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="6dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/late"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <!-- Widget cards -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp"
            android:background="@drawable/card">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:padding="18dp"
                android:background="@drawable/hero_icon_bg"
                android:scaleType="centerInside"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher_fg"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/txt_main"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:text="@string/home_empty_title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/txt_sub"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:text="@string/home_empty_body"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Status strip: last refresh + tap to refresh -->
    <LinearLayout
        android:id="@+id/status_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/card"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginRight="9dp"
            android:contentDescription="@string/refresh_now"
            android:src="@drawable/ic_refresh"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/txt_clock"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/offline"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="6dp"
            android:rotation="180"
            android:contentDescription="@null"
            android:src="@drawable/ic_back"/>
    </LinearLayout>
</LinearLayout>
