<?xml version="1.0" encoding="utf-8"?>
<!--
  Divia widget, v1.5.0 COMPACT layout variant ("line badge + minutes only,
  denser rows"), pushed instead of widget_divia.xml when the widget's
  config has compact=true.

  HARD CONSTRAINT — @RemoteView whitelist: identical to widget_divia.xml,
  the launcher inflates this file in ITS OWN process through
  RemoteViews.apply(); only @RemoteView-annotated classes are allowed
  (LinearLayout, ImageView, TextView here). check_widget_layout.py and the
  JVM LayoutWhitelist guard both re-assert this.

  ID REUSE — every id that exists in widget_divia.xml keeps the SAME name
  (and therefore the same pinned numeric id from stable-ids.txt): row0..4,
  count0..4 (the minutes), dest0..4 (in compact: the small "dernier" tag,
  GONE unless the row is the day's last departure), stop_name, line_badge,
  empty_status, updated, widget_root. Only cbadge0..4 (the per-row line
  badges) are new ids, appended to stable-ids.txt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="5dp">

    <!-- Header: line badge + stop name, single line (no subtitle, no
         divider — that is the point of the compact disposition). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/line_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/stop_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/txt_main"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Divia"/>
    </LinearLayout>

    <!-- Departure rows: 20dp (vs 24dp in the detailed layout) — denser.
         Each row = the line's badge bitmap (BadgeRender.makeCompact) +
         the minutes countdown. destN carries only the "dernier" tag. -->
    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cbadge0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/count0"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/countdown"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/dest0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/txt_sub"
            android:textSize="10sp"
            android:textStyle="italic"
            android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cbadge1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/count1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/countdown"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/dest1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/txt_sub"
            android:textSize="10sp"
            android:textStyle="italic"
            android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cbadge2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/count2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/countdown"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/dest2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/txt_sub"
            android:textSize="10sp"
            android:textStyle="italic"
            android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cbadge3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/count3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/countdown"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/dest3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/txt_sub"
            android:textSize="10sp"
            android:textStyle="italic"
            android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cbadge4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/count4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/countdown"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/dest4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/txt_sub"
            android:textSize="10sp"
            android:textStyle="italic"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Empty / error status -->
    <TextView
        android:id="@+id/empty_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/txt_sub"
        android:textSize="11sp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"/>

    <!-- Footer -->
    <TextView
        android:id="@+id/updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/txt_clock"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="1dp"/>
</LinearLayout>
