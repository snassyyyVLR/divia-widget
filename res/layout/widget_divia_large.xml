<?xml version="1.0" encoding="utf-8"?>
<!--
  Divia widget RemoteViews layout — v1.7.0 LARGE-TEXT variant of
  widget_divia.xml: identical structure and view ids (so every
  RemoteViews call of the detailed branch resolves unchanged), with
  bigger type and taller rows for readability at arm's length.

  HARD CONSTRAINT — @RemoteView whitelist (same as every variant):
  only classes the launcher's RemoteViews inflater allows may appear
  here (no plain <View> — see widget_divia.xml's header comment).

  HARD CONSTRAINT — @RemoteView whitelist: the launcher inflates this file
  in ITS OWN process through RemoteViews.apply(), whose LayoutInflater
  filter only allows classes annotated @RemoteView:
    FrameLayout, LinearLayout, RelativeLayout, GridLayout,
    AnalogClock, Button, Chronometer, ImageButton, ImageView,
    ProgressBar, TextView, ViewFlipper, ListView, GridView,
    StackView, AdapterViewFlipper, ViewStub.
  A plain <View> (used as the divider in v1.x) is NOT on that list ->
  "Class not allowed to be instantiated: android.view.View" ->
  "Problem loading widget" on EVERY launcher (platform-enforced).
  The 1dp divider below is therefore a TextView. run_harness.sh now
  fails the build if a non-whitelisted class ever comes back.

  All view ids are identical to v1.x so widgets bound under previous
  versions keep resolving after an in-place update.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <!-- Header: line badge + stop name. The badge is an ImageView: the
         line's official color is painted into a small bitmap in our
         process (BadgeRender) and pushed via setImageViewBitmap, because
         RemoteViews cannot recolor a drawable per line on API 21+. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/line_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:contentDescription="@null"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp">

            <TextView
                android:id="@+id/stop_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/txt_main"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Divia"/>

            <TextView
                android:id="@+id/line_dest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/txt_sub"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="…"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 1dp divider: TextView, NOT <View> (see header comment) -->
    <TextView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"/>

    <!-- Departure rows -->
    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dest0"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_main"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/countdown"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginLeft="6dp"/>

        <TextView
            android:id="@+id/clock0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_clock"
            android:textSize="14sp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dest1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_main"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/countdown"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginLeft="6dp"/>

        <TextView
            android:id="@+id/clock1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_clock"
            android:textSize="14sp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dest2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_main"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/countdown"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginLeft="6dp"/>

        <TextView
            android:id="@+id/clock2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_clock"
            android:textSize="14sp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <!-- v1.1.0: rows 3 and 4 appear only when the widget is tall (or the row
         override is set); they stay GONE otherwise. New ids, appended after
         the v1.x ones so stable-ids.txt keeps pinning the old numbering. -->
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dest3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_main"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/countdown"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginLeft="6dp"/>

        <TextView
            android:id="@+id/clock3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_clock"
            android:textSize="14sp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dest4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_main"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/count4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/countdown"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginLeft="6dp"/>

        <TextView
            android:id="@+id/clock4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_clock"
            android:textSize="14sp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <!-- Empty / error status -->
    <TextView
        android:id="@+id/empty_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/txt_sub"
        android:textSize="13sp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"/>

    <!-- Footer -->
    <TextView
        android:id="@+id/updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/txt_clock"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"/>
</LinearLayout>
