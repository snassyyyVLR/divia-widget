<?xml version="1.0" encoding="utf-8"?>
<!-- Line / direction / stop picker (pure configuration flow; diagnostics
     moved to Settings). v1.6.0: icon back button, segmented mode control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg">

    <!-- Header with the (contextual) back icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:visibility="gone"
            android:background="@drawable/btn_icon"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="6dp">

            <TextView
                android:id="@+id/config_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/txt_main"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/config_title"/>

            <TextView
                android:id="@+id/config_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/txt_sub"
                android:textSize="13sp"
                android:paddingTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/step_lines"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Segmented line/stop mode control -->
    <RadioGroup
        android:id="@+id/mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/seg_container"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:padding="3dp">

        <RadioButton
            android:id="@+id/mode_line_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:background="@drawable/seg_btn_left"
            android:textColor="@drawable/seg_text_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:checked="true"
            android:text="@string/mode_line"/>

        <RadioButton
            android:id="@+id/mode_stop_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:background="@drawable/seg_btn_right"
            android:textColor="@drawable/seg_text_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="@string/mode_stop"/>
    </RadioGroup>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="@drawable/edittext_bg"
        android:textColor="@color/txt_main"
        android:textColorHint="@color/txt_clock"
        android:textSize="14sp"
        android:inputType="text"
        android:maxLines="1"
        android:hint="@string/search_hint"/>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>
</LinearLayout>
