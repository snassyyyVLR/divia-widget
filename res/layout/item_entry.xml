<?xml version="1.0" encoding="utf-8"?>
<!-- One list entry as a rounded card (used on the home widget list and the
     config picker). v1.6.0: ripple on tap, colored line pill, chevron.
     The badge pill is tinted per-line from Java (HomeActivity /
     ConfigActivity adapters) via getBackground().setTint(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingRight="10dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:background="@drawable/item_card_ripple">

    <TextView
        android:id="@+id/item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="46dp"
        android:background="@drawable/badge_bg"
        android:textColor="@color/badge_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="4dp">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_main"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textColor="@color/txt_sub"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        android:rotation="180"
        android:contentDescription="@null"
        android:src="@drawable/ic_back"/>
</LinearLayout>
